---
import { withBase } from "@/utils/base";

interface Props {
  page: number;
  pages: number;
}

const { page, pages } = Astro.props;

const visible = pages > 1;

const indicators = Array.from({ length: pages }, (_, i) => i);

// Page 0 lives at "/", page i at "/{i}".
const prevHref = page === 0 ? null : page === 1 ? "/" : `/${page - 1}`;
const nextHref = page >= pages - 1 ? null : `/${page + 1}`;
---

{
  visible && (
    <div class="flex justify-center flex-wrap gap-2 py-4 text-sm">
      {prevHref ? (
        <a class="rounded border px-3 h-8 flex items-center justify-center" href={withBase(prevHref)}>
          Previous
        </a>
      ) : (
        <span class="rounded border px-3 h-8 flex items-center justify-center opacity-40">Previous</span>
      )}
      {indicators.map((i) => (
        <a
          class={
            `rounded border w-8 h-8 overflow-hidden whitespace-pre-wrap flex items-center justify-center` +
            (i === page ? " bg-gray text-white" : "")
          }
          href={withBase(i === 0 ? "/" : `/${i}`)}>
          {i + 1}
        </a>
      ))}
      {nextHref ? (
        <a class="rounded border px-3 h-8 flex items-center justify-center" href={withBase(nextHref)}>
          Next
        </a>
      ) : (
        <span class="rounded border px-3 h-8 flex items-center justify-center opacity-40">Next</span>
      )}
    </div>
  )
}
